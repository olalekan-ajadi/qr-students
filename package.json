{
  "name": "e-students-qr-system",
  "version": "1.0.0",
  "description": "Electronic Students' Information Storage System using QR Code",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "init-db": "node server/db/init.js",
    "build": "npm install --include=dev --prefix client && npm run build --prefix client",
    "start": "node server/db/init.js && node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.2",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
