PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qr_students

# --- Secrets ---
# Generate a UNIQUE value for EACH of the three below. Do not reuse one value.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_64+_char_random_hex
QR_ENC_KEY=replace_with_a_DIFFERENT_random_hex
CARD_TOKEN_SECRET=replace_with_ANOTHER_random_hex

# Default admin account seeded by db/init.js on first run. Change the password
# after first login. If ADMIN_PASSWORD is omitted, init.js generates a random
# one and prints it once to the console.
ADMIN_EMAIL=admin@university.edu.ng
ADMIN_PASSWORD=

# Comma-separated list of front-end origins allowed by CORS (production).
# In development the Vite proxy makes requests same-origin, so this is only
# enforced when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173

SCHOOL_NAME=Federal University
SCHOOL_SHORT=FU
